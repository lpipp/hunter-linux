+++ b/drivers/platform/x86/hunter_wire.h
@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef HUNTER_WIRE_H
+#define HUNTER_WIRE_H
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/string.h>
+#else
+#include <errno.h>
+#include <string.h>
+#endif
+#include "hunter_protocol.h"
+
+static inline int hunter_encode(unsigned int op, u8 input[64])
+{
+	memset(input, 0, 64);
+	switch (op) {
+	case HUNTER_GET_MODE:
+		input[0] = 4; input[1] = 0x12; break;
+	case HUNTER_GET_FAN0:
+	case HUNTER_GET_FAN1:
+		input[0] = 2; input[1] = 8;
+		input[2] = op - HUNTER_GET_FAN0; break;
+	default:
+		return -EOPNOTSUPP;
+	}
+	return 0;
+}
+
+/* Only the three documented firmware modes are valid CLI results. */
+static inline int hunter_decode(unsigned int op, const u8 payload[256], int *value)
+{
+	if (payload[0])
+		return -EREMOTEIO;
+	switch (op) {
+	case HUNTER_GET_MODE:
+		if (payload[1] > 2)
+			return -EPROTO;
+		*value = payload[1]; break;
+	case HUNTER_GET_FAN0:
+	case HUNTER_GET_FAN1:
+		*value = payload[1] | (payload[2] << 8); break;
+	default: return -EOPNOTSUPP;
+	}
+	return 0;
+}
+
+/* Host-testable strict payload adapter. The ACPI wrapper validates types. */
+static inline int hunter_adapt(unsigned int format, const u8 *reserved,
+			      unsigned int rlen, const u8 *data,
+			      unsigned int dlen, struct hunter_attempt *out)
+{
+	if (format == HUNTER_FORMAT_FLAT260) {
+		if (!data || dlen != 260)
+			return -EPROTO;
+		reserved = data;
+		data += 4;
+	} else if (format == HUNTER_FORMAT_PACKAGE) {
+		if (!reserved || rlen != 4 || !data || dlen != 256)
+			return -EPROTO;
+	} else {
+		return -EPROTO;
+	}
+	memcpy(out->reserved, reserved, 4);
+	memcpy(out->payload, data, 256);
+	out->format = format;
+	out->status = data[0];
+	return 0;
+}
+
+/* Caller holds the common OEM transaction mutex across this entire function.
+ * Raw callback owns/frees its ACPI allocation on every attempt.
+ * Never retry a transport/format error. Hunter retries only status 1;
+ * legacy callers keep their pre-existing nonzero-status retry policy.
+ */
+typedef int (*hunter_raw_fn)(void *, const u8 *, unsigned int,
+			     struct hunter_attempt *);
+static inline int hunter_transact(void *context, hunter_raw_fn raw,
+		const u8 *input, unsigned int length, int legacy,
+		struct hunter_request *result)
+{
+	unsigned int i;
+	int err;
+	for (i = 0; i < 2; i++) {
+		struct hunter_attempt *attempt = &result->trace[i];
+		attempt->status = 0xffffffffU;
+		result->attempts++;
+		err = raw(context, input, length, attempt);
+		attempt->error = err;
+		if (err)
+			return err;
+		if (!attempt->status)
+			return 0;
+		if (!legacy && attempt->status != 1)
+			break;
+	}
+	return -EREMOTEIO;
+}
+#endif
--- /dev/null
+++ b/drivers/platform/x86/hunter_transport.inc
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* This file replaces Utils in the existing distribution Huawei driver. */
+static int huawei_wmi_raw(void *context, const u8 *input, unsigned int length,
+			  struct hunter_attempt *trace)
+{
+	struct huawei_wmi *huawei = context;
+	struct acpi_buffer in = { length, (void *)input };
+	struct acpi_buffer out = { ACPI_ALLOCATE_BUFFER, NULL };
+	union acpi_object *obj, *elements;
+	u64 start = ktime_get_ns();
+	acpi_status status;
+	int err = -EPROTO;
+
+	lockdep_assert_held(&huawei->wmi_lock);
+	status = wmi_evaluate_method(HWMI_METHOD_GUID, 0, 1, &in, &out);
+	trace->acpi_status = status;
+	if (ACPI_FAILURE(status)) {
+		err = -EIO;
+		goto done;
+	}
+	obj = out.pointer;
+	if (!obj)
+		goto done;
+	if (obj->type == ACPI_TYPE_BUFFER) {
+		err = hunter_adapt(HUNTER_FORMAT_FLAT260, NULL, 0,
+			obj->buffer.pointer, obj->buffer.length, trace);
+	} else if (obj->type == ACPI_TYPE_PACKAGE &&
+		   obj->package.count == 2 && obj->package.elements) {
+		elements = obj->package.elements;
+		if (elements[0].type == ACPI_TYPE_BUFFER &&
+		    elements[1].type == ACPI_TYPE_BUFFER)
+			err = hunter_adapt(HUNTER_FORMAT_PACKAGE,
+				elements[0].buffer.pointer, elements[0].buffer.length,
+				elements[1].buffer.pointer, elements[1].buffer.length, trace);
+	}
+done:
+	/* Fresh ACPI_ALLOCATE_BUFFER for every attempt; never adjust ownership. */
+	kfree(out.pointer);
+	trace->duration_ns = ktime_get_ns() - start;
+	return err;
+}
+
+static int huawei_wmi_transaction(struct huawei_wmi *huawei, const u8 *input,
+		unsigned int length, bool legacy, struct hunter_request *result)
+{
+	int err;
+	mutex_lock(&huawei->wmi_lock);
+	if (huawei->hunter.stopped ||
+	    (!legacy && (!huawei->hunter.matched || huawei->hunter.removing)))
+		err = -ENODEV;
+	else if (huawei->hunter.suspended)
+		err = -EBUSY;
+	else
+		err = hunter_transact(huawei, huawei_wmi_raw, input, length,
+				      legacy, result);
+	mutex_unlock(&huawei->wmi_lock);
+	return err;
+}
+
+/* Legacy commands preserve 8-byte inputs and the historical retry policy,
+ * but now the mutex covers both attempts and each ACPI result is freed.
+ */
+static int huawei_wmi_cmd(u64 arg, u8 *buf, size_t buflen)
+{
+	struct hunter_request result = {};
+	int err;
+	err = huawei_wmi_transaction(huawei_wmi, (u8 *)&arg, sizeof(arg),
+				     true, &result);
+	if (result.attempts && result.trace[result.attempts - 1].format && buf)
+		memcpy(buf, result.trace[result.attempts - 1].payload,
+		       min_t(size_t, buflen, 256));
+	return err == -EREMOTEIO ? -ENODEV : err;
+}
--- /dev/null
+++ b/drivers/platform/x86/hunter_platform.inc
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+static bool hunter_matches(void)
+{
+	return dmi_match(DMI_SYS_VENDOR, "HUAWEI") &&
+	       dmi_match(DMI_PRODUCT_NAME, "FRD-WX9") &&
+	       dmi_match(DMI_BOARD_NAME, "FRD-WX9-PCB") &&
+	       dmi_match(DMI_PRODUCT_VERSION, "M1060") &&
+	       dmi_match(DMI_BIOS_VERSION, "1.18");
+}
+
+/* Each sysfs read explicitly queries firmware. No timers or cached mode:
+ * the motherboard's performance key may change it at any time.
+ */
+static int hunter_read(struct huawei_wmi *huawei, unsigned int op, int *value)
+{
+	struct hunter_request result = {};
+	u8 input[64];
+	int err;
+	err = hunter_encode(op, input);
+	if (err)
+		return err;
+	err = huawei_wmi_transaction(huawei, input, sizeof(input), false, &result);
+	if (err)
+		return err;
+	return hunter_decode(op, result.trace[result.attempts - 1].payload, value);
+}
+
+static ssize_t mode_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct huawei_wmi *huawei = dev_get_drvdata(dev);
+	int value, err;
+	err = hunter_read(huawei, HUNTER_GET_MODE, &value);
+	return err ? err : sysfs_emit(buf, "%d\n", value);
+}
+static DEVICE_ATTR_RO(mode);
+
+static ssize_t fans_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct huawei_wmi *huawei = dev_get_drvdata(dev);
+	int fan1, fan2, err;
+	err = hunter_read(huawei, HUNTER_GET_FAN0, &fan1);
+	if (err)
+		return err;
+	err = hunter_read(huawei, HUNTER_GET_FAN1, &fan2);
+	return err ? err : sysfs_emit(buf, "%d %d\n", fan1, fan2);
+}
+static DEVICE_ATTR_RO(fans);
+
+static struct attribute *hunter_attrs[] = {
+	&dev_attr_mode.attr,
+	&dev_attr_fans.attr,
+	NULL,
+};
+static const struct attribute_group hunter_group = {
+	.name = "hunter",
+	.attrs = hunter_attrs,
+};
+
+static int hunter_setup(struct huawei_wmi *huawei)
+{
+	int err;
+	if (!hunter_matches())
+		return 0;
+	mutex_lock(&huawei->wmi_lock);
+	huawei->hunter.matched = true;
+	mutex_unlock(&huawei->wmi_lock);
+	err = sysfs_create_group(&huawei->dev->kobj, &hunter_group);
+	if (err) {
+		mutex_lock(&huawei->wmi_lock);
+		huawei->hunter.matched = false;
+		mutex_unlock(&huawei->wmi_lock);
+	}
+	return err;
+}
+
+static void hunter_stop(struct huawei_wmi *huawei)
+{
+	bool matched;
+	mutex_lock(&huawei->wmi_lock);
+	huawei->hunter.removing = true;
+	matched = huawei->hunter.matched;
+	mutex_unlock(&huawei->wmi_lock);
+	/* Removal drains sysfs readers. Keep legacy transport alive until the
+	 * existing LED and battery cleanup in huawei_wmi_remove has finished.
+	 */
+	if (matched)
+		sysfs_remove_group(&huawei->dev->kobj, &hunter_group);
+	mutex_lock(&huawei->wmi_lock);
+	huawei->hunter.matched = false;
+	mutex_unlock(&huawei->wmi_lock);
+}
+
+static int hunter_pm_suspend(struct device *dev)
+{
+	struct huawei_wmi *huawei = dev_get_drvdata(dev);
+	mutex_lock(&huawei->wmi_lock);
+	huawei->hunter.suspended = true;
+	mutex_unlock(&huawei->wmi_lock);
+	return 0;
+}
+static int hunter_pm_resume(struct device *dev)
+{
+	struct huawei_wmi *huawei = dev_get_drvdata(dev);
+	mutex_lock(&huawei->wmi_lock);
+	huawei->hunter.suspended = false;
+	mutex_unlock(&huawei->wmi_lock);
